{
  "expo": {
    "name": "ESL Exercises",
    "slug": "esl-exercises-25",
    "version": "2.0.5",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "eslexercises25",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#fffff0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.petereasterbro1.eslexercises25",
      "permissions": [
        "com.android.vending.BILLING"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "ios": {
      "bundleIdentifier": "com.petereasterbro1.eslexercises25",
      "supportsTablet": false,
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "ESL Exercises uses the camera so you can take a photo for your profile picture.",
        "NSPhotoLibraryUsageDescription": "ESL Exercises accesses your photo library so you can choose a profile picture."
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-web-browser",
        {
          "android": {
            "preferringCustomTabs": true
          }
        }
      ],
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "ESL Exercises accesses your photo library so you can choose a profile picture.",
          "cameraPermission": "ESL Exercises uses the camera so you can take a photo for your profile picture."
        }
      ],
      [
        "expo-updates",
        {
          "username": "petereasterbro1"
        }
      ],
      "react-native-iap",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ],
      "expo-font",
      "expo-sharing",
      "expo-splash-screen",
      "expo-status-bar",
      "react-native-nitro-google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "53f70f64-bf01-4bf3-a088-e969fff88646"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/53f70f64-bf01-4bf3-a088-e969fff88646"
    }
  }
}
