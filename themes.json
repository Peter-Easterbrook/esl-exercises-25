{
  "_notes": {
    "structure": "Each theme defines the same set of semantic color roles used across the app. 'accent' contains a 5-stop scale from darkest (CTA buttons, active states) to lightest (inactive/decorative). All shadow values include web (boxShadow) strings. Status colors (success/warning/danger/error) are theme-adapted but remain universally legible.",
    "roles": {
      "backgrounds.app": "Main screen background color",
      "backgrounds.card": "Card / surface background",
      "backgrounds.subtle": "Slightly off-screen-background, used on list screens",
      "backgrounds.tinted": "Very faint accent wash (inner cards, zebra rows)",
      "backgrounds.tintedStrong": "Stronger accent wash (menu icon backgrounds, hover states)",
      "backgrounds.progressCircle": "Background fill for circular progress indicators",
      "text.primary": "Body text, labels",
      "text.title": "Heading / hero text",
      "text.secondary": "Descriptions, subtitles, captions",
      "text.accent": "Score displays, link-style text",
      "accent.darkest": "Primary CTA buttons, active tab icons, high-contrast interactive",
      "accent.dark": "Secondary buttons, headers, navigation text",
      "accent.mid": "Borders on selected items, progress bar fill, icon accents",
      "accent.light": "Inactive tab icons, light decorative elements",
      "accent.lightest": "Wash/tint backgrounds, chips, tag fills",
      "tabBar.background": "Tab bar surface",
      "tabBar.activeTint": "Active tab icon and label",
      "tabBar.inactiveTint": "Inactive tab icon and label",
      "tabBar.border": "Top border of tab bar",
      "icons.primary": "Main action icons",
      "icons.secondary": "Supporting / navigation icons",
      "icons.tertiary": "Chevrons, decorative icons",
      "icons.placeholder": "Disabled / empty state icons",
      "borders.subtle": "Hairline borders on cards (barely visible)",
      "borders.light": "Option button borders, list item separators",
      "borders.medium": "Focused / hover border states",
      "borders.strong": "Selected item border, review left-bar accent",
      "borders.divider": "Horizontal rule between sections",
      "borders.dividerLight": "Very light intra-item dividers",
      "status.success": "Completed, correct, positive feedback",
      "status.warning": "In-progress, caution states",
      "status.danger": "Errors, destructive actions",
      "status.error": "Advanced-level badge text, critical errors",
      "difficulty.*": "Background + text pairs for beginner/intermediate/advanced badges",
      "destructive.*": "Sign-out button and similar destructive-action components",
      "shadow.color": "Base color for React Native elevation shadows",
      "shadow.level1/2/3": "Web boxShadow strings matching the three elevation levels"
    }
  },

